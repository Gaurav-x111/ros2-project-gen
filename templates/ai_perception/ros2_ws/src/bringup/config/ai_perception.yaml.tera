# {{ name }} AI Perception Stack Configuration

# ML Inference
ml_inference:
  model: "{{ ml | default(value="yolov8") | lower }}"
  inference_backend: "{{ inference | lower }}"
  model_path: "models/{{ ml | default(value="yolov8") | lower }}.onnx"
  input_topic: "{{ name }}/camera/image_raw"
  output_topic: "{{ name }}/detections"
  confidence_threshold: 0.5
  iou_threshold: 0.45
  input_width: 640
  input_height: 640
  classes:
    - "person"
    - "bicycle"
    - "car"
    - "motorcycle"
    - "airplane"
    - "bus"
    - "train"
    - "truck"
    - "boat"
    - "traffic light"

# Point Cloud Processor
pointcloud_processor:
  input_topic: "{{ name }}/lidar/points"
  output_topic: "{{ name }}/lidar/points_filtered"
  voxel_size: 0.1
  backend: "{{ pointcloud|lower }}"
  remove_outliers: true

# Camera
camera:
  topic: "{{ name }}/camera/image_raw"
  frame_id: "camera_link"
  width: 1280
  height: 720
  fps: 30

# TF transforms
transforms:
  base_to_camera:
    x: 0.0
    y: 0.0
    z: 0.3
    roll: 0.0
    pitch: 0.0
    yaw: 0.0
  base_to_lidar:
    x: 0.0
    y: 0.0
    z: 0.5
    roll: 0.0
    pitch: 0.0
    yaw: 0.0