from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument
from launch.conditions import IfCondition
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch_ros.actions import Node
from launch_ros.substitutions import FindPackageShare


def generate_launch_description():
    # Launch arguments
    model = LaunchConfiguration('model')
    inference_backend = LaunchConfiguration('inference_backend')
    use_pointcloud = LaunchConfiguration('use_pointcloud')

    declare_model = DeclareLaunchArgument(
        'model', default_value='{{ ml | default(value="yolov8") | lower }}',
        description='ML model: yolov8, yolo11, sam, depth_anything')

    declare_backend = DeclareLaunchArgument(
        'inference_backend', default_value='{{ inference|lower }}',
        description='Inference backend: onnx, tensorrt, pytorch, openvino')

    declare_pointcloud = DeclareLaunchArgument(
        'use_pointcloud', default_value='true',
        description='Launch point cloud processor')

    # ML Inference node
    ml_inference = Node(
        package='{{ name }}_ml_inference',
        executable='{{ name }}_ml_inference',
        name='{{ name }}_ml_inference',
        output='screen',
        parameters=[{
            'model_path': PathJoinSubstitution([
                FindPackageShare('{{ name }}_bringup'),
                'models',
                LaunchConfiguration('model') + '.onnx'
            ]),
            'input_topic': '{{ name }}/camera/image_raw',
            'output_topic': '{{ name }}/detections',
            'confidence_threshold': 0.5,
            'iou_threshold': 0.45,
            'input_width': 640,
            'input_height': 640,
        }],
    )

    # Point cloud processor (optional)
    pointcloud_processor = Node(
        package='{{ name }}_pointcloud_processor',
        executable='{{ name }}_pointcloud_processor',
        name='{{ name }}_pointcloud_processor',
        output='screen',
        parameters=[{
            'input_topic': '{{ name }}/lidar/points',
            'output_topic': '{{ name }}/lidar/points_filtered',
            'voxel_size': 0.1,
        }],
        condition=IfCondition(use_pointcloud),
    )

    return LaunchDescription([
        declare_model,
        declare_backend,
        declare_pointcloud,
        ml_inference,
        pointcloud_processor,
    ])