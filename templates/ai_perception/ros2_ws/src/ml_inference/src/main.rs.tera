use rclrs::{Context, Node, Publisher, Subscription, QoSProfile, QoSReliabilityPolicy, QoSDurabilityPolicy, QoSHistoryPolicy};
use sensor_msgs::msg::Image;
use vision_msgs::msg::{Detection2DArray, Detection2D, ObjectHypothesisWithPose, BoundingBox2D};
use std::sync::Arc;
use ort::session::{Session, builder::GraphOptimizationLevel};
use ndarray::{Array4, s};
use image::{DynamicImage, ImageBuffer, Rgb};

#[derive(Debug, Clone)]
struct InferenceConfig {
    model_path: String,
    input_topic: String,
    output_topic: String,
    confidence_threshold: f32,
    iou_threshold: f32,
    input_width: u32,
    input_height: u32,
    classes: Vec<String>,
}

struct YoloDetector {
    session: Session,
    config: InferenceConfig,
}

impl YoloDetector {
    fn new(config: InferenceConfig) -> Result<Self, Box<dyn std::error::Error>> {
        let session = Session::builder()?
            .with_optimization_level(GraphOptimizationLevel::Level3)?
            .with_intra_threads(4)?
            .commit_from_file(&config.model_path)?;

        Ok(Self { session, config })
    }

    fn preprocess(&self, img: &DynamicImage) -> Result<Array4<f32>, Box<dyn std::error::Error>> {
        let resized = img.resize_exact(
            self.config.input_width,
            self.config.input_height,
            image::imageops::FilterType::Triangle,
        );

        let rgb = resized.to_rgb8();
        let mut input = Array4::<f32>::zeros((1, 3, self.config.input_height as usize, self.config.input_width as usize));

        for y in 0..self.config.input_height as usize {
            for x in 0..self.config.input_width as usize {
                let pixel = rgb.get_pixel(x as u32, y as u32);
                input[[0, 0, y, x]] = pixel[0] as f32 / 255.0;
                input[[0, 1, y, x]] = pixel[1] as f32 / 255.0;
                input[[0, 2, y, x]] = pixel[2] as f32 / 255.0;
            }
        }

        Ok(input)
    }

    fn postprocess(&self, output: &ndarray::ArrayViewD<f32>) -> Vec<Detection2D> {
        let mut detections = Vec::new();
        // Simplified post-processing for YOLOv8
        // Real implementation would parse the output tensor properly
        detections
    }

    fn detect(&self, img: &DynamicImage) -> Result<Vec<Detection2D>, Box<dyn std::error::Error>> {
        let input = self.preprocess(img)?;
        let outputs = self.session.run(ort::inputs!["images" => input.view()])?;
        let output = outputs["output0"].try_extract_tensor::<f32>()?;
        Ok(self.postprocess(&output))
    }
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let context = Context::new(std::env::args())?;
    let node = Node::new(&context, "{{ name }}_ml_inference")?;

    let config = InferenceConfig {
        model_path: "models/yolov8n.onnx".to_string(),
        input_topic: "{{ name }}/camera/image_raw".to_string(),
        output_topic: "{{ name }}/detections".to_string(),
        confidence_threshold: 0.5,
        iou_threshold: 0.45,
        input_width: 640,
        input_height: 640,
        classes: vec![
            "person".into(), "bicycle".into(), "car".into(), "motorcycle".into(),
            "airplane".into(), "bus".into(), "train".into(), "truck".into(),
        ],
    };

    let detector = Arc::new(YoloDetector::new(config.clone())?);

    let publisher = node.create_publisher::<Detection2DArray>(
        &config.output_topic,
        QoSProfile::default()
            .reliability(QoSReliabilityPolicy::Reliable)
            .durability(QoSDurabilityPolicy::Volatile)
            .history(QoSHistoryPolicy::KeepLast(10)),
    )?;

    let detector_clone = detector.clone();
    let _subscription = node.create_subscription::<Image>(
        &config.input_topic,
        QoSProfile::default()
            .reliability(QoSReliabilityPolicy::Reliable)
            .durability(QoSDurabilityPolicy::Volatile)
            .history(QoSHistoryPolicy::KeepLast(10)),
        move |msg: Image| {
            // Convert ROS Image to DynamicImage
            // This is simplified - real implementation uses cv_bridge
            let width = msg.width as u32;
            let height = msg.height as u32;
            
            if let Ok(img_buffer) = ImageBuffer::<Rgb<u8>, _>::from_raw(width, height, msg.data.clone()) {
                let dynamic_img = DynamicImage::ImageRgb8(img_buffer);
                
                if let Ok(detections) = detector_clone.detect(&dynamic_img) {
                    let mut det_array = Detection2DArray::default();
                    det_array.header = msg.header.clone();
                    det_array.detections = detections;
                    publisher.publish(&det_array).ok();
                }
            }
        },
    )?;

    println!("ML Inference node started");
    println!("Model: {}", config.model_path);
    println!("Input: {}", config.input_topic);
    println!("Output: {}", config.output_topic);
    println!("Classes: {:?}", config.classes);

    rclrs::spin(&node)?;
    Ok(())
}