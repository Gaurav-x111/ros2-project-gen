from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, ExecuteProcess
from launch.conditions import IfCondition
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node


def generate_launch_description():
    # Launch arguments
    use_rust = LaunchConfiguration('use_rust')
    use_cpp = LaunchConfiguration('use_cpp')
    use_python = LaunchConfiguration('use_python')

    declare_use_rust = DeclareLaunchArgument(
        'use_rust', default_value='true',
        description='Launch Rust node')
    declare_use_cpp = DeclareLaunchArgument(
        'use_cpp', default_value='true',
        description='Launch C++ node')
    declare_use_python = DeclareLaunchArgument(
        'use_python', default_value='true',
        description='Launch Python node')

    # Rust and Python nodes install their executables into bin/, which
    # `Node()` can't resolve (it looks in lib/<pkg>/). Run them via
    # ExecuteProcess; the ament_prefix_path puts them on PATH after sourcing.
    rust_node = ExecuteProcess(
        cmd=['{{ name }}_rust_node'],
        output='screen',
        condition=IfCondition(use_rust),
    )

    cpp_talker = Node(
        package='{{ name }}_cpp_node',
        executable='talker',
        name='{{ name }}_cpp_talker',
        output='screen',
        condition=IfCondition(use_cpp),
    )

    cpp_listener = Node(
        package='{{ name }}_cpp_node',
        executable='listener',
        name='{{ name }}_cpp_listener',
        output='screen',
        condition=IfCondition(use_cpp),
    )

    python_talker = ExecuteProcess(
        cmd=['talker'],
        output='screen',
        condition=IfCondition(use_python),
    )

    python_listener = ExecuteProcess(
        cmd=['listener'],
        output='screen',
        condition=IfCondition(use_python),
    )

    return LaunchDescription([
        declare_use_rust,
        declare_use_cpp,
        declare_use_python,
        rust_node,
        cpp_talker,
        cpp_listener,
        python_talker,
        python_listener,
    ])